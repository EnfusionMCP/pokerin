FROM node:24-alpine@sha256:705813e7dd798f8a69a2b0d8fb958ecafe5fc3b2a52139ae03a0379246301c4a AS frontend-build

WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --no-audit --no-fund

COPY frontend/ ./
COPY backend/ws/protocol.schema.json /protocol.schema.json
RUN node scripts/generate-protocol.mjs --check --schema /protocol.schema.json \
    && npm run build

FROM golang:1.26.6-alpine@sha256:3889b425f035be855a72fb4755265311293b6d414521f0a519d819df32222d83 AS caddy-build

WORKDIR /src
COPY deploy/caddy-build/go.mod deploy/caddy-build/go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" \
        -o /usr/local/bin/caddy github.com/caddyserver/caddy/v2/cmd/caddy

FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b

RUN apk upgrade --no-cache \
    && apk add --no-cache ca-certificates mailcap

COPY --from=caddy-build /usr/local/bin/caddy /usr/bin/caddy
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=frontend-build /build/dist /srv/frontend
RUN caddy list-modules >/dev/null \
    && caddy validate --config /etc/caddy/Caddyfile

EXPOSE 80 443 443/udp
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
