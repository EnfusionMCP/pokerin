# Database
DATABASE_URL=postgresql+asyncpg://pokerin:pokerin@localhost:5432/pokerin

# Redis
REDIS_URL=redis://localhost:6379/0

# EVE SSO
EVE_CLIENT_ID=your_client_id_here
EVE_CALLBACK_URL=http://localhost:8080/auth/callback
EVE_SCOPES=publicData

# Bank character (for deposit detection)
BANK_CHARACTER_ID=0
BANK_REFRESH_TOKEN=your_bank_refresh_token_here
BANK_CLIENT_ID=your_bank_sso_client_id_here

# App JWT
JWT_SECRET=change-this-to-a-random-256-bit-hex-string
JWT_EXPIRE_HOURS=24

# Server
HOST=0.0.0.0
PORT=8080
DEBUG=true
BASE_URL=http://localhost:8080
