# Database (production Compose). Generate one URL-safe value with
# `python -c "import secrets; print(secrets.token_hex(32))"` and put that exact
# hex value in both password positions. For a host-run dev server, change
# `postgres` to `localhost` without changing POSTGRES_DB.
POSTGRES_PASSWORD=replace_with_the_same_64_character_hex_value
POSTGRES_DB=pokerin
POSTGRES_VOLUME_NAME=pokerin_pgdata
DATABASE_URL=postgresql+asyncpg://pokerin:replace_with_the_same_64_character_hex_value@postgres:5432/pokerin
# Obtain this once from pg_control_system() as documented in deploy/README.md.
# It prevents a renamed checkout/project from silently using a fresh cluster.
DB_EXPECTED_SYSTEM_IDENTIFIER=replace_with_numeric_postgresql_system_identifier

# EVE SSO
EVE_CLIENT_ID=your_client_id_here
EVE_CALLBACK_URL=https://pokerin.space/auth/callback
EVE_SCOPES=publicData

# Bank character (for deposit detection)
BANK_CHARACTER_ID=0
BANK_REFRESH_TOKEN=your_bank_refresh_token_here
BANK_CLIENT_ID=your_bank_sso_client_id_here

# App JWT
# Required: generate a unique value, for example with `python -c "import secrets; print(secrets.token_hex(32))"`.
# Startup rejects blank values, published placeholders, and secrets shorter than 32 UTF-8 bytes.
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# Server
HOST=0.0.0.0
PORT=8080
DEBUG=false
BASE_URL=https://pokerin.space

# Production Compose backup gate (not used by docker-compose.dev.yml).
# BACKUP_DIR must be an absolute durable host path. Prefer an encrypted,
# monitored off-host mount; a missing/wrong mount fails closed via its marker.
BACKUP_DIR=/mnt/offsite/pokerin
BACKUP_DESTINATION_ID=replace-with-a-stable-destination-id
BACKUP_RETENTION_COUNT=30
BACKUP_COMPRESSION_LEVEL=6
# postgres:16-alpine uses uid/gid 70. Override only to match the mounted store.
BACKUP_CONTAINER_UID=70
BACKUP_CONTAINER_GID=70
